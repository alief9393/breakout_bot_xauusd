# breakout_bot_xauusd — credentials. Copy to .env and fill in. .env is gitignored — NEVER commit it.

# ── cTrader Open API ── (data download + cTrader execution)  https://openapi.ctrader.com
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=
CTRADER_ACCESS_TOKEN=          # this one expires — refresh when a pull says "token expired"
CTRADER_HOST_TYPE=demo         # demo | live   (always start on demo)
CTRADER_ACCOUNT_ID=0           # 0 = auto-pick first demo account
CTRADER_SYMBOL=XAUUSD

# ── data downloader (backtest/fetch_prices.py) ──
CTRADER_PERIOD=M1
CTRADER_HISTORY_YEARS=3        # how far back to pull
CTRADER_WINDOW_DAYS=5          # per-request window (speed only; never affects correctness)
CTRADER_REQUEST_DELAY=0.6      # seconds between requests (be gentle; the API throttles)
# CTRADER_HISTORY_CSV=data/xauusd_m1.csv   # output path (default is data/xauusd_m1.csv)

# ── MT5 execution (live/live_mt5.py, Windows only) ── leave blank if the terminal is already logged in
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_SYMBOL=XAUUSD

# ── safety switch (both live engines) ──
EXECUTE_ENABLED=False          # False = dry-run (logs intents, sends NOTHING). Set True to trade.
