# StreamTrade — all credentials in ONE place (this project is self-contained).
# Copy to .env and fill in.  .env is gitignored — never commit it.

# ── Telegram (channel streaming + live bot) ── from https://my.telegram.org
TG_API_ID=
TG_API_HASH=
TG_CHANNEL=@Raahimbfxproo
TG_SESSION=streamtrade

# ── cTrader (price verification + trade execution) ── from https://openapi.ctrader.com
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=
CTRADER_ACCESS_TOKEN=          # this one expires — refresh it when the pull says "token expired"
CTRADER_HOST_TYPE=demo        # demo | live
CTRADER_ACCOUNT_ID=0          # 0 = auto-pick first demo account
CTRADER_SYMBOL=XAUUSD
CTRADER_PERIOD=M1
CTRADER_HISTORY_YEARS=0.6
CTRADER_WINDOW_DAYS=5
CTRADER_REQUEST_DELAY=0.6
CTRADER_HISTORY_CSV=xauusd_m1.csv
